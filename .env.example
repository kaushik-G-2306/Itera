# Firebase configuration — replace with your project values
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890

# Optional: Google Gemini API key (for live Gemini 2.0 Flash calls)
# If not set, Itera uses the built-in intelligent domain offline engine
VITE_GEMINI_API_KEY=your-gemini-api-key
